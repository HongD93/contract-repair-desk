{
  "version":1,"name":"Dispatch queue","requirements":"Return {id,title,priority,state} arrays from tickets. id and the chosen title must be non-empty strings. Use non-empty title before summary. Priority must be an integer 0–3: 0 becomes Critical and 1–3 become P1–P3. State mappings are open=Open, done=Done, assigned=In progress. Only exact own values are supported. Invalid or missing fields throw Unsupported dispatch response. Empty tickets is valid.",
  "checks":[
    {"id":"legacy-ticket","purpose":"preserve","input":{"tickets":[{"id":"T-1","title":"Inspect valve","priority":2,"state":"open"}]},"expected":[{"id":"T-1","title":"Inspect valve","priority":"P2","state":"Open"}]},
    {"id":"title-precedence","purpose":"preserve","input":{"tickets":[{"id":"T-2","title":"Old","summary":"New","priority":1,"state":"done"}]},"expected":[{"id":"T-2","title":"Old","priority":"P1","state":"Done"}]},
    {"id":"critical-assignment","purpose":"migration","input":{"tickets":[{"id":"T-3","summary":"Emergency inspection","priority":0,"state":"assigned"}]},"expected":[{"id":"T-3","title":"Emergency inspection","priority":"Critical","state":"In progress"}]},
    {"id":"empty-queue","purpose":"preserve","input":{"tickets":[]},"expected":[]},
    {"id":"unknown-state","purpose":"reject","input":{"tickets":[{"id":"T-4","title":"Check","priority":1,"state":"paused"}]},"error":"Unsupported dispatch response"},
    {"id":"prototype-state","purpose":"reject","input":{"tickets":[{"id":"T-5","title":"Check","priority":1,"state":"toString"}]},"error":"Unsupported dispatch response"},
    {"id":"invalid-priority","purpose":"reject","input":{"tickets":[{"id":"T-6","title":"Check","priority":-1,"state":"open"}]},"error":"Unsupported dispatch response"}
  ]
}
